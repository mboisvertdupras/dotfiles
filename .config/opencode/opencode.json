{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "opencode-memory-extract": { "model": "claude-agent/sonnet#medium", "steps": 20 },
    "opencode-memory-recall":  { "model": "claude-agent/haiku#high" },
    "opencode-memory-dream":   { "model": "claude-agent/opus#high" }
  },
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest"
        ]
      }
    }
  },
  "experimental": {
    "todo": true,
    "subagent_depth": 2,
    "artifacts": true,
    "background_compaction": true
  },
  "worktree": {
    "directory": ".opencode/trees",
  },
  "plugins": [
    "pstack-opencode",
    "opencode-claude-memory"
  ]
}

