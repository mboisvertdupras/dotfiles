{
  "theme": {
    "name": "cursor",
    "mode": "system"
  },
  "diffs": {
    "wrap": "none",
    "single": false,
    "view": "auto"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "hide",
    "permissions": "autoaccept",
    "verbosity": "low"
  },
  "animations": true,
  "tabs": {
    "mode": "off"
  },
  "attention": {
    "sound": false,
    "notifications": true
  },
  "prompt": {
    "image_preview": true
  },
  "debug": {
    "devtools": false
  },
  "experimental": {
    "new-designs": false,
    "client-mcp": false
  },
  "plugins": [
    "opencode-autosuggestions"
  ]
}
